# LLM API 配置（任意 OpenAI 兼容服务：DeepSeek / 智谱 GLM / OpenAI 等）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# ── LLM 采样参数（不填则用 config.py 里的默认值）──
# LLM_TEMPERATURE：采样温度，取值 0.0~2.0，默认 0.3。
#   0 = 完全确定（同样输入几乎相同输出），1.0+ = 高度随机（易发散）。
#   测试用例生成建议 0.2~0.5：既保证复现稳定，又能覆盖一些边界值/异常场景。
#   DeepSeek V4 Pro 官方通用推荐 1.0，但结构化 JSON 输出场景请忽略该推荐、保持低值。
LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS：单次响应最大输出 token 数，默认 8192。
#   注意这是"输出"上限，与"上下文窗口"（输入+输出总量，如 V4 Pro 的 1M）无关。
#   参考：8192 ≈ 20-40 条测试用例；16384 ≈ 40-80 条；32768 ≈ 80-160 条。
#   加大 = 单次能出更多用例，但生成时间线性增长、成本线性增长、末段易跑偏。
#   建议：8192 (稳) / 16384 (中) / 32768 (激进)；不推荐 >32768。
LLM_MAX_TOKENS=8192
# LLM_REASONING_EFFORT：可选，让支持 Think 模式的模型走对应思考强度。
#   合法值：low / medium / high / max；留空则不传该字段。
#   目前对 DeepSeek V4 Pro / V4 Flash 等生效；其他不识别的服务商会忽略。
#   开到 max 用例质量最好，但生成慢 3-5 倍、贵 2-3 倍——按需开启。
LLM_REASONING_EFFORT=

# ── 使用 DeepSeek V4 Pro 的参考配置（1M 上下文 MoE 模型）──
# ⚠️ 走 OpenAI 兼容端点（/v1），不是 Anthropic 兼容端点（/anthropic）。
# 需要 JSON 结构化输出的场景优先 DeepSeek 官方 / Together / DeepInfra，稳定性高。
# LLM_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-v4-pro
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=16384
# LLM_REASONING_EFFORT=max

# ── 向量检索阈值（不填则用 config.py 里的默认值，填了会覆盖默认值）──
# VECTOR_MIN_DISTANCE_THRESHOLD：L2 距离上限，默认 12.0。
#   覆盖效果：最近的向量结果距离超过此值，视为"完全不相关"，整批丢弃。
#   调大=更宽松（更容易命中知识），调小=更严格（更容易判定无关）。
VECTOR_MIN_DISTANCE_THRESHOLD=12.0
# VECTOR_DISTANCE_DELTA：相关性增量，默认 4.0。
#   覆盖效果：在已判定相关的前提下，只保留距离不超过「最小距离 + 此增量」的结果。
#   调大=保留更多条相关 chunk，调小=只保留最贴近的几条。
VECTOR_DISTANCE_DELTA=4.0

# ── 飞书开放平台自建应用凭证（用于「从飞书导入 PRD」功能）──
# 在 https://open.feishu.cn/app 创建自建应用后拿到，并申请以下权限：
#   - wiki:wiki:readonly / wiki:node:read（读取知识库节点）
#   - docx:document:readonly（读取云文档内容）
# 应用发布并被目标知识空间授权后才能真正拉到内容。留空则前端「从飞书导入」按钮会报错提示。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
